# ── Database ──────────────────────────────────────────────
# PostgreSQL 14+ connection string
DATABASE_URL="postgresql://mpl_inventory:change-me@localhost:5432/mpl_inventory?schema=public"

# ── Sessions ──────────────────────────────────────────────
# Sign out after this many minutes of inactivity (server-enforced; the UI warns 1 minute before)
SESSION_IDLE_MINUTES=60
# Absolute session lifetime in hours
SESSION_MAX_HOURS=12
# Set to "false" only if serving over plain HTTP inside a trusted network (cookies are Secure by default in production)
COOKIE_SECURE=true

# ── Time zone used to decide "today" (verification due dates, dashboard greeting) ──
APP_TIMEZONE=Indian/Maldives

# ── Seed (first run only) ─────────────────────────────────
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL=admin@mpl.mv
SEED_ADMIN_PASSWORD=ChangeMe@2026
# Create one demo user per role (officer@ / ops@ / viewer@mpl.mv). Set to "false" in production.
SEED_DEMO_USERS=true
SEED_DEMO_PASSWORD=Demo@12345
# Workbook imported on first seed (defaults to prisma/data/Inventory TEst.xlsx)
# SEED_WORKBOOK=/path/to/Inventory.xlsx

# ── Offline / restricted environments only ────────────────
# Run migrations through Prisma's WebAssembly schema engine when engine binaries can't be downloaded
# PRISMA_JS_ENGINE=1
